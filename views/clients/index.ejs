<input type="hidden" id="csrfToken" value="<%= csrfToken %>" />
<div class="container-fluid py-4">
  <div
    class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"
  >
    <div>
      <h1 class="h3 mb-1">Clients</h1>
      <p class="text-muted mb-0">
        Manage your agency clients and relationships.
      </p>
    </div>

    <button
      type="button"
      class="btn btn-oscar"
      data-bs-toggle="modal"
      data-bs-target="#clientModal"
      onclick="openCreateClientModal()"
    >
      <i class="bi bi-plus-lg me-2"></i>
      Add Client
    </button>
  </div>

  <!-- Filters -->
  <div class="card mb-4">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-lg-6">
          <label for="clientSearch" class="form-label">Search</label>
          <input
            type="search"
            id="clientSearch"
            class="form-control"
            placeholder="Company, contact or email..."
          />
        </div>

        <div class="col-lg-3">
          <label for="clientStatus" class="form-label">Status</label>
          <select id="clientStatus" class="form-select">
            <option value="">All statuses</option>
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
            <option value="Onboarding">Onboarding</option>
            <option value="Completed">Completed</option>
          </select>
        </div>

        <div class="col-lg-3 d-flex align-items-end">
          <button
            type="button"
            class="btn btn-outline-light w-100"
            id="refreshClients"
          >
            <i class="bi bi-arrow-clockwise me-2"></i>
            Refresh
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Clients table -->
  <div class="card">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>Company</th>
              <th>Contact</th>
              <th>Email</th>
              <th>Industry</th>
              <th>Status</th>
              <th>Created</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>

          <tbody id="clientsTableBody">
            <tr>
              <td colspan="7" class="text-center text-muted py-5">
                Loading clients...
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="d-flex justify-content-between align-items-center mt-4">
        <button
          type="button"
          class="btn btn-outline-light"
          id="previousClientPage"
        >
          <i class="bi bi-chevron-left me-1"></i>
          Previous
        </button>

        <span id="clientPaginationInfo" class="text-muted"> Page 1 </span>

        <button type="button" class="btn btn-outline-light" id="nextClientPage">
          Next
          <i class="bi bi-chevron-right ms-1"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Client Modal -->
<div class="modal fade" id="clientModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="clientModalTitle">Add Client</h5>

        <button
          type="button"
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
        ></button>
      </div>

      <form id="clientForm">
        <div class="modal-body">
          <input type="hidden" id="clientId" />

          <div class="row g-3">
            <div class="col-md-6">
              <label for="companyName" class="form-label">
                Company Name *
              </label>
              <input
                type="text"
                id="companyName"
                class="form-control"
                required
              />
            </div>

            <div class="col-md-6">
              <label for="contactName" class="form-label"> Contact Name </label>
              <input type="text" id="contactName" class="form-control" />
            </div>

            <div class="col-md-6">
              <label for="email" class="form-label"> Email </label>
              <input type="email" id="email" class="form-control" />
            </div>

            <div class="col-md-6">
              <label for="phone" class="form-label"> Phone </label>
              <input type="text" id="phone" class="form-control" />
            </div>

            <div class="col-md-6">
              <label for="website" class="form-label"> Website </label>
              <input
                type="url"
                id="website"
                class="form-control"
                placeholder="https://example.com"
              />
            </div>

            <div class="col-md-6">
              <label for="industry" class="form-label"> Industry </label>
              <input type="text" id="industry" class="form-control" />
            </div>

            <div class="col-md-6">
              <label for="location" class="form-label"> Location </label>
              <input type="text" id="location" class="form-control" />
            </div>

            <div class="col-md-6">
              <label for="status" class="form-label"> Status </label>
              <select id="status" class="form-select">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
                <option value="Onboarding">Onboarding</option>
                <option value="Completed">Completed</option>
              </select>
            </div>

            <div class="col-12">
              <label for="notes" class="form-label"> Notes </label>
              <textarea id="notes" class="form-control" rows="4"></textarea>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button
            type="button"
            class="btn btn-outline-light"
            data-bs-dismiss="modal"
          >
            Cancel
          </button>

          <button type="submit" class="btn btn-oscar" id="saveClientButton">
            Save Client
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const clientsTableBody = document.getElementById("clientsTableBody");
  const clientSearch = document.getElementById("clientSearch");
  const clientStatus = document.getElementById("clientStatus");
  const refreshClients = document.getElementById("refreshClients");
  const previousClientPage = document.getElementById("previousClientPage");
  const nextClientPage = document.getElementById("nextClientPage");
  const clientPaginationInfo = document.getElementById("clientPaginationInfo");
  const clientForm = document.getElementById("clientForm");
  const clientModal = document.getElementById("clientModal");

  let currentClientPage = 1;

  let clientModalInstance = null;

  function getClientModal() {
    if (!clientModalInstance) {
      clientModalInstance = bootstrap.Modal.getOrCreateInstance(clientModal);
    }

    return clientModalInstance;
  }

  function openCreateClientModal() {
    clientForm.reset();

    document.getElementById("clientId").value = "";

    document.getElementById("clientModalTitle").textContent = "Add Client";

    document.getElementById("saveClientButton").textContent = "Save Client";
  }

  function formatDate(date) {
    if (!date) return "—";

    return new Date(date).toLocaleDateString("en-ZA", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  }

  function escapeHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function statusBadge(status) {
    const classes = {
      Active: "text-bg-success",
      Inactive: "text-bg-secondary",
      Onboarding: "text-bg-warning",
      Completed: "text-bg-primary",
    };

    return `
      <span class="badge ${classes[status] || "text-bg-secondary"}">
        ${escapeHtml(status || "Unknown")}
      </span>
    `;
  }

  function renderClients(clients) {
    if (!clients.length) {
      clientsTableBody.innerHTML = `
        <tr>
          <td colspan="7" class="text-center text-muted py-5">
            No clients found.
          </td>
        </tr>
      `;

      return;
    }

    clientsTableBody.innerHTML = clients
      .map(
        (client) => `
      <tr>

        <td>
          <strong>${escapeHtml(client.companyName)}</strong>
        </td>

        <td>
          ${escapeHtml(client.contactName || "—")}
        </td>

        <td>
          ${escapeHtml(client.email || "—")}
        </td>

        <td>
          ${escapeHtml(client.industry || "—")}
        </td>

        <td>
          ${statusBadge(client.status)}
        </td>

        <td>
          ${formatDate(client.createdAt)}
        </td>

        <td class="text-end">
          <button
            type="button"
            class="btn btn-sm btn-primary me-2"
            onclick="editClient('${client._id}')"
          >
            <i class="bi bi-pencil me-1"></i>
            Edit
          </button>

          <button
            type="button"
            class="btn btn-sm btn-outline-danger"
            onclick="removeClient('${client._id}')"
          >
            <i class="bi bi-trash me-1"></i>
            Delete
          </button>
        </td>
      </tr>
    `,
      )
      .join("");
  }

  function updateClientPagination(pagination) {
    const { page, totalPages, total } = pagination;

    const displayTotalPages = Math.max(totalPages, 1);

    clientPaginationInfo.textContent = `Page ${page} of ${displayTotalPages} · ${total} client${total === 1 ? "" : "s"}`;

    previousClientPage.disabled = page <= 1;

    nextClientPage.disabled = page >= displayTotalPages;
  }

  async function loadClients() {
    clientsTableBody.innerHTML = `
      <tr>
        <td colspan="7" class="text-center text-muted py-5">
          Loading clients...
        </td>
      </tr>
    `;

    try {
      const params = new URLSearchParams();

      params.set("page", currentClientPage);
      params.set("limit", 20);

      if (clientSearch.value.trim()) {
        params.set("search", clientSearch.value.trim());
      }

      if (clientStatus.value) {
        params.set("status", clientStatus.value);
      }

      const response = await fetch(`/api/clients?${params.toString()}`, {
        credentials: "same-origin",
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.error || "Unable to load clients.");
      }

      renderClients(result.data.clients);

      updateClientPagination(result.data.pagination);
    } catch (error) {
      console.error(error);

      clientsTableBody.innerHTML = `
        <tr>
          <td colspan="7" class="text-center text-danger py-5">
            ${escapeHtml(error.message)}
          </td>
        </tr>
      `;
    }
  }

  async function editClient(clientId) {
    try {
      const response = await fetch(`/api/clients/${clientId}`, {
        credentials: "same-origin",
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.error || "Unable to load client.");
      }

      const client = result.data;

      document.getElementById("clientId").value = client._id;

      document.getElementById("companyName").value = client.companyName || "";

      document.getElementById("contactName").value = client.contactName || "";

      document.getElementById("email").value = client.email || "";

      document.getElementById("phone").value = client.phone || "";

      document.getElementById("website").value = client.website || "";

      document.getElementById("industry").value = client.industry || "";

      document.getElementById("location").value = client.location || "";

      document.getElementById("status").value = client.status || "Active";

      document.getElementById("notes").value = client.notes || "";

      document.getElementById("clientModalTitle").textContent = "Edit Client";

      document.getElementById("saveClientButton").textContent = "Update Client";

      getClientModal().show();
    } catch (error) {
      console.error(error);
      alert(error.message);
    }
  }

  async function removeClient(clientId) {
    if (!confirm("Delete this client? This action cannot be undone.")) {
      return;
    }

    try {
      const response = await fetch(`/api/clients/${clientId}`, {
        method: "DELETE",
        headers: {
          "x-csrf-token": document.getElementById("csrfToken").value,
        },
        credentials: "same-origin",
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.error || "Unable to delete client.");
      }

      await loadClients();
    } catch (error) {
      console.error(error);
      alert(error.message);
    }
  }

  clientForm.addEventListener("submit", async (event) => {
    event.preventDefault();

    const clientId = document.getElementById("clientId").value;

    const payload = {
      companyName: document.getElementById("companyName").value.trim(),

      contactName: document.getElementById("contactName").value.trim(),

      email: document.getElementById("email").value.trim(),

      phone: document.getElementById("phone").value.trim(),

      website: document.getElementById("website").value.trim(),

      industry: document.getElementById("industry").value.trim(),

      location: document.getElementById("location").value.trim(),

      status: document.getElementById("status").value,

      notes: document.getElementById("notes").value.trim(),
    };

    const isEditing = Boolean(clientId);

    try {
      const response = await fetch(
        isEditing ? `/api/clients/${clientId}` : "/api/clients",
        {
          method: isEditing ? "PATCH" : "POST",

          headers: {
            "Content-Type": "application/json",
            "x-csrf-token": document.getElementById("csrfToken").value,
          },
          credentials: "same-origin",

          body: JSON.stringify(payload),
        },
      );

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.error || "Unable to save client.");
      }

      getClientModal().hide();

      currentClientPage = 1;

      await loadClients();
    } catch (error) {
      console.error(error);
      alert(error.message);
    }
  });

  previousClientPage.addEventListener("click", () => {
    if (currentClientPage <= 1) return;

    currentClientPage--;

    loadClients();
  });

  nextClientPage.addEventListener("click", () => {
    currentClientPage++;

    loadClients();
  });

  clientStatus.addEventListener("change", () => {
    currentClientPage = 1;

    loadClients();
  });

  let searchTimeout;

  clientSearch.addEventListener("input", () => {
    clearTimeout(searchTimeout);

    searchTimeout = setTimeout(() => {
      currentClientPage = 1;
      loadClients();
    }, 350);
  });

  refreshClients.addEventListener("click", loadClients);

  loadClients();
</script>
