<div class="auth-shell">
  <div class="auth-card glass-card">
    <div class="brand-mark mb-4">OSCAR</div>
    <p class="eyebrow">AI AGENCY ASSISTANT</p>
    <h1 class="h3 fw-bold mb-2">Welcome back</h1>
    <p class="text-secondary mb-4">Sign in to the OwenTech command center.</p>

    <% if (error) { %>
      <div class="alert alert-danger border-0"><%= error %></div>
    <% } %>

    <form action="/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input class="form-control form-control-lg oscar-input" type="email" id="email" name="email" autocomplete="email" required>
      </div>

      <div class="mb-4">
        <label class="form-label" for="password">Password</label>
        <input class="form-control form-control-lg oscar-input" type="password" id="password" name="password" autocomplete="current-password" required>
      </div>

      <button class="btn btn-oscar btn-lg w-100" type="submit">
        <i class="bi bi-box-arrow-in-right me-2"></i>
        Sign in
      </button>
    </form>
  </div>
</div>
