<div class="app-shell">
  <aside class="sidebar" id="sidebar">

    <div class="brand">
      <div class="brand-title">OSCAR</div>
      <div class="brand-subtitle">AI Agency Assistant</div>

      <!-- Desktop collapse -->
      <button
        type="button"
        class="sidebar-toggle desktop-toggle"
        id="desktopSidebarToggle"
        aria-label="Collapse sidebar">
        <i class="bi bi-chevron-left"></i>
      </button>
    </div>

    <!-- Mobile close -->
    <button
      type="button"
      class="sidebar-toggle mobile-toggle"
      id="mobileSidebarClose"
      aria-label="Close navigation">
      <i class="bi bi-x-lg"></i>
    </button>

    <nav class="sidebar-nav">

      <% const items = [
      ["bi-grid-1x2-fill", "Dashboard", "/dashboard"],
      ["bi-stars", "AI Assistant", "#oscar-assistant"],
      ["bi-person-lines-fill", "Leads", "/leads"],
      ["bi-send", "Outreach", "/emails"],
      ["bi-people", "Clients", "/clients"],
      ["bi-kanban", "Projects", "/projects"],
      ["bi-envelope", "Emails", "/emails"],
      ["bi-calendar3", "Calendar", "/calendar"],
      ["bi-check2-square", "Tasks", "/tasks"],
      ["bi-bar-chart-line", "Analytics", "/analytics"],
      ["bi-receipt", "Invoices", "/invoices"],
      ["bi-file-earmark-text", "Documents", "/documents"],
      ["bi-gear", "Settings", "/settings"]
      ]; %>

      <% items.forEach(([icon, label, href]) => { %>

      <a
        href="<%= href %>"
        class="sidebar-link <%= currentPath === href ? 'active' : '' %>"
        title="<%= label %>">
        <i class="bi <%= icon %>"></i>
        <span><%= label %></span>
      </a>

      <% }) %>

    </nav>

   <div
    class="voice-panel"
    id="oscarSidebarVoice"
    data-configured="<%= voiceConfigured ? 'true' : 'false' %>"
  >
    <div class="d-flex align-items-center justify-content-between gap-2">
      <strong class="small">OSCAR Voice</strong>
      <span id="sidebarVoiceBadge" class="badge bg-secondary">
        <%= voiceConfigured ? "Ready" : "Not configured" %>
      </span>
    </div>

    <p
      id="sidebarVoiceStatus"
      class="small text-secondary mt-3 mb-3"
      role="status"
      aria-live="polite"
    >
      <%= voiceConfigured
        ? "Start a voice conversation with OSCAR."
        : "Voice will be available after AI setup is complete." %>
    </p>

    <button
      id="sidebarVoiceStart"
      type="button"
      class="btn btn-oscar w-100"
      <%= voiceConfigured ? "" : "disabled" %>
    >
      <i class="bi bi-mic-fill me-2" aria-hidden="true"></i>
      Start conversation
    </button>

    <div class="d-flex gap-2 mt-2">
      <button
        id="sidebarVoiceMute"
        type="button"
        class="btn btn-sm btn-outline-light flex-fill"
        aria-pressed="false"
        disabled
      >Mute</button>

      <button
        id="sidebarVoiceEnd"
        type="button"
        class="btn btn-sm btn-outline-danger flex-fill"
        disabled
      >End</button>
    </div>

    <p class="small text-secondary mt-3 mb-0">
      Business actions still require their normal approvals.
    </p>
  </div>

  </aside>

  <!-- Mobile overlay -->
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <main class="main-content">
    <header class="topbar">
      <button class="icon-btn d-lg-none" id="mobileMenuButton" type="button">
        <i class="bi bi-list"></i>
      </button>

      <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="search" placeholder="Search anything..."
          aria-label="Search">
        <kbd>Ctrl /</kbd>
      </div>

      <div class="topbar-actions">
        <button class="icon-btn"><i class="bi bi-bell"></i></button>
        <a href="/settings" class="icon-btn" aria-label="Open settings">
        <i class="bi bi-gear"></i>
        </a>
        <div class="profile">
          <div class="avatar"><%= user.name.slice(0, 1).toUpperCase() %></div>
          <div class="d-none d-md-block">
            <div class="profile-name"><%= user.name %></div>
            <div class="profile-role"><%= user.role %></div>
          </div>
        </div>
        <form action="/logout" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="icon-btn" title="Sign out"><i
              class="bi bi-box-arrow-right"></i></button>
        </form>
      </div>
    </header>

    <section class="dashboard-content">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">OWENTECH COMMAND CENTER</p>
          <h1>
            <span id="timeGreeting">Good Evening</span>,
            <%= user.name.split(" ")[0] %>
          </h1>
          <p class="hero-text">
            I'm OSCAR, your AI business assistant.<br>
            How can I help you grow OwenTech today?
          </p>

          <div class="quick-actions">
            <button
              type="button"
              class="btn btn-oscar"
              data-oscar-prompt="Find new leads for OwenTech. Identify suitable prospects and explain why they are good fits.">
              <i class="bi bi-search me-2"></i>
              Find new leads
            </button>

            <button
              type="button"
              class="btn btn-ghost"
              data-oscar-prompt="Help me prepare outreach emails for suitable prospects. Draft them for review before sending.">
              <i class="bi bi-send me-2"></i>
              Send outreach emails
            </button>

            <button
              type="button"
              class="btn btn-ghost"
              data-oscar-prompt="Generate a business report using the available OwenTech business data. Clearly identify any unavailable metrics.">
              <i class="bi bi-bar-chart-line me-2"></i>
              Show business report
            </button>

            <button
              type="button"
              class="btn btn-ghost"
              data-oscar-prompt="Help me analyze a website. Ask me for the website URL if I have not provided one.">
              <i class="bi bi-globe2 me-2"></i>
              Analyze website
            </button>
          </div>
        </div>

        <!-- ================= OSCAR CORE ================= -->

        <div class="oscar-core"  id="oscar-assistant">

          <!-- ================= 3D OSCAR BRAIN ================= -->

          <div class="oscar-brain">
            <div
              id="oscarBrain"
              class="oscar-brain-stage"
              aria-label="OSCAR AI Brain"></div>
          </div>

          <!-- ================= OSCAR CHAT ================= -->

          <div class="chat-card glass-card">

            <div
              class="chat-header d-flex justify-content-between align-items-center">

              <span>Chat with OSCAR</span>

              <span class="status-pill" id="oscarChatStatus">
              <%= voiceConfigured ? "Configured" : "Not configured" %>
              </span>

            </div>

            <div id="oscarMessages" class="oscar-messages">

              <div class="chat-message oscar-message">

               <strong>
                <%= voiceConfigured
                  ? "How can I help, Sir?"
                  : "OSCAR workspace is ready, Sir." %>
              </strong>

              <p class="mb-0 mt-2">
                <%= voiceConfigured
                  ? "Ask about your leads, clients, invoices, or business operations."
                  : "AI chat and voice are awaiting configuration. Your business pages remain available while we complete the build." %>
              </p>

              </div>

            </div>

            <div id="confirmationContainer"></div>

            <form id="oscarChatForm" class="chat-input">

              <button
                type="button"
                id="oscarVoiceBtn"
                class="oscar-send-btn"
                title="Start voice conversation"
                aria-label="Start voice conversation"
                aria-pressed="false">
                <i class="bi bi-mic-fill"></i>
              </button>

              <input
                id="oscarInput"
                type="text"
                class="form-control"
                placeholder="<%= voiceConfigured ? 'Ask OSCAR anything...' : 'AI setup pending' %>"
                autocomplete="off"
                <%= voiceConfigured ? "" : "disabled" %>
                required
              />

              <button
              id="oscarSendMessageBtn"
              type="submit"
              class="oscar-send-btn"
              title="Send message"
              aria-label="Send message"
              <%= voiceConfigured ? "" : "disabled" %>
            >
              <i class="bi bi-send-fill"></i>
            </button>

            </form>

            <div
              id="oscarVoiceStatus"
              class="small mt-2"
              role="status"
              aria-live="polite">
              <%= voiceConfigured
              ? "Voice conversation is off."
              : "Voice will be available after AI setup is complete." %>
            </div>

            <audio id="oscarVoiceAudio" autoplay></audio>

          </div>

        </div>
        <!-- ================= END OSCAR CORE ================= -->
      </div>

      <div class="kpi-grid">
        <%- include("../partials/kpi", { icon: "bi-currency-dollar", label:
        "Revenue", value: metrics.revenue.toLocaleString("en-ZA", { style:
        "currency", currency: "ZAR" }), trend: "Database" }) %>
        <%- include("../partials/kpi", { icon: "bi-people", label:
        "Active Clients", value: metrics.activeClients, trend: "Database" })
        %>
        <%- include("../partials/kpi", { icon: "bi-bullseye", label:
        "Potential Leads", value: metrics.potentialLeads, trend: "Database" })
        %>
        <%- include("../partials/kpi", { icon: "bi-send", label:
        "Emails Sent",
        value: metrics.emailsSent.toLocaleString(), trend: "Database" }) %>
        <%- include("../partials/kpi", { icon: "bi-envelope-check", label:
        "Responses", value: metrics.responses.toLocaleString(), trend:
        "Database" }) %>
        <%- include("../partials/kpi", { icon: "bi-graph-up-arrow", label:
        "Conversion Rate", value: `${metrics.conversionRate.toFixed(1)}%`,
        trend: "Database" }) %>
      </div>

      <div class="empty-grid dashboard-overview-grid">
        <div class="dashboard-panel glass-card">
          <div class="panel-heading">
            <div>
              <span class="eyebrow">BUSINESS ACTIVITY</span>
              <h2>Recent Activity</h2>
            </div>

            <span class="badge-soft">
              <%= activities.length %> recent events
            </span>
          </div>

         <% if (activities.length > 0) { %>
          <div
            id="dashboardActivityList"
            class="activity-list dashboard-activity-scroll"
            role="region"
            aria-label="Recent business activity"
            tabindex="0"
          >
            <%
              const activityLabels = {
                "auth.login": "Signed in",
                "auth.logout": "Signed out",
                "confirmed_create_lead": "Created a lead",
                "confirmed_update_lead": "Updated a lead",
                "confirmed_delete_lead": "Deleted a lead",
                "confirmed_create_client": "Created a client",
                "confirmed_update_client": "Updated a client",
                "confirmed_delete_client": "Deleted a client",
                "confirmed_send_email": "Sent an email",
                "confirmed_schedule_email": "Scheduled an email",
                "confirmed_create_invoice": "Created an invoice",
                "confirmed_update_invoice": "Updated an invoice",
                "confirmed_mark_invoice_sent": "Marked an invoice as sent",
                "confirmed_mark_invoice_paid": "Marked an invoice as paid",
                "confirmed_cancel_invoice": "Cancelled an invoice"
              };
            %>

            <% activities.forEach((activity) => { %>
              <div class="activity-item">
                <div class="activity-icon">
                  <i class="bi bi-activity" aria-hidden="true"></i>
                </div>

                <div class="activity-content">
                  <strong>
                    <%= activityLabels[activity.action] ||
                      String(activity.action || "Business activity").replace(/_/g, " ") %>
                  </strong>

                  <p>
                    <%= activity.resourceType %>

                    <% if (
                      activity.resourceId &&
                      !String(activity.action || "").startsWith("auth.")
                    ) { %>
                      · Reference: <%= activity.resourceId %>
                    <% } %>
                  </p>

                  <small>
                    <%= activity.actor %>
                    ·
                    <%= new Date(activity.createdAt).toLocaleString("en-ZA", {
                      dateStyle: "medium",
                      timeStyle: "short"
                    }) %>
                  </small>
                </div>
              </div>
            <% }) %>
          </div>
          <% } else { %>
            <div class="empty-state">
              <i class="bi bi-clock-history"></i>
              <h3>No activity recorded yet</h3>
              <p>
                Recorded business actions will appear here.
              </p>
            </div>
          <% } %>
        </div>

       <div class="dashboard-panel glass-card">
          <div class="panel-heading">
            <div>
              <span class="eyebrow">OSCAR SYSTEM</span>
              <h2>System Overview</h2>
            </div>

            <span class="status-pill">Operational Overview</span>
          </div>

          <div class="agent-list">
            <div>
              <span>Authentication</span>
              <strong>Session protected</strong>
            </div>

            <div>
              <span>Business Database</span>
              <strong>MongoDB-backed</strong>
            </div>

            <div>
              <span>Text Chat</span>
              <strong>AI credentials required</strong>
            </div>

            <div>
              <span>Realtime Voice</span>
              <strong>AI credentials required</strong>
            </div>

            <div>
              <span>MCP Tools</span>
              <strong>Available for integration</strong>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>

<script>
  const csrfToken = document.querySelector('input[name="_csrf"]')?.value;

  function updateTimeGreeting() {
    const greetingElement =
      document.getElementById("timeGreeting");

    if (!greetingElement) return;

    const hour = new Date().getHours();

    if (hour >= 5 && hour < 12) {
      greetingElement.textContent = "Good Morning";
    } else if (hour >= 12 && hour < 18) {
      greetingElement.textContent = "Good Afternoon";
    } else {
      greetingElement.textContent = "Good Evening";
    }
  }

  updateTimeGreeting();

  setInterval(updateTimeGreeting, 60 * 1000);

// =========================================================
// OSCAR SIDEBAR CONTROLS
// =========================================================

const oscarSidebar =
  document.getElementById("sidebar");

const desktopSidebarToggle =
  document.getElementById("desktopSidebarToggle");

const mobileSidebarClose =
  document.getElementById("mobileSidebarClose");

const sidebarOverlay =
  document.getElementById("sidebarOverlay");

// =========================================================
// DESKTOP COLLAPSE
// =========================================================

desktopSidebarToggle?.addEventListener("click", () => {

  oscarSidebar.classList.toggle("collapsed");

  const isCollapsed =
    oscarSidebar.classList.contains("collapsed");

  localStorage.setItem(
    "oscarSidebarCollapsed",
    isCollapsed
  );

});


// =========================================================
// RESTORE DESKTOP SIDEBAR STATE
// =========================================================

if (
  window.innerWidth > 800 &&
  localStorage.getItem("oscarSidebarCollapsed") === "true"
) {

  oscarSidebar.classList.add("collapsed");

}
mobileMenuButton?.addEventListener("click", () => {

  oscarSidebar.classList.add("mobile-open");

  sidebarOverlay.classList.add("active");

});
// =========================================================
// MOBILE CLOSE
// =========================================================

function closeMobileSidebar() {

  oscarSidebar.classList.remove("mobile-open");

  sidebarOverlay.classList.remove("active");

}


mobileSidebarClose?.addEventListener(
  "click",
  closeMobileSidebar
);

sidebarOverlay?.addEventListener(
  "click",
  closeMobileSidebar
);


// =========================================================
// CLOSE AFTER NAVIGATION
// =========================================================

document
  .querySelectorAll(".sidebar-link")
  .forEach(link => {

    link.addEventListener("click", () => {

      if (window.innerWidth <= 800) {

        closeMobileSidebar();

      }

    });

  });


// =========================================================
// HANDLE RESIZE
// =========================================================

window.addEventListener("resize", () => {

  if (window.innerWidth > 800) {

    closeMobileSidebar();

  }

});
</script>
<script>
  const oscarChatForm = document.getElementById("oscarChatForm");
  const oscarInput = document.getElementById("oscarInput");
  const oscarMessages = document.getElementById("oscarMessages");
  const confirmationContainer = document.getElementById(
    "confirmationContainer"
  );

  function addOscarMessage(message, type = "oscar") {
    const messageElement = document.createElement("div");

    messageElement.className =
      type === "user"
        ? "chat-message user-message"
        : "chat-message oscar-message";

    messageElement.textContent = message;

    oscarMessages.appendChild(messageElement);
    oscarMessages.scrollTop = oscarMessages.scrollHeight;
  }

 function showConfirmation(confirmation) {
  confirmationContainer.innerHTML = "";

  const card = document.createElement("div");
  card.className = "confirmation-card";

  const title = document.createElement("strong");
  title.textContent = "Confirmation Required";

  const description = document.createElement("p");
  description.textContent =
    confirmation.message || "OSCAR is requesting confirmation.";

  const details = document.createElement("div");
  details.className = "confirmation-details";

  if (confirmation.details) {
    Object.entries(confirmation.details).forEach(([key, value]) => {
      if (!value) return;

      const row = document.createElement("div");
      row.className = "confirmation-detail-row";

      const label = document.createElement("span");
      label.className = "confirmation-detail-label";
      label.textContent = formatConfirmationLabel(key);

      const detailValue = document.createElement("span");
      detailValue.className = "confirmation-detail-value";
      detailValue.textContent = formatConfirmationValue(key, value);

      row.appendChild(label);
      row.appendChild(detailValue);

      details.appendChild(row);
    });
  }

  const actions = document.createElement("div");
  actions.className = "confirmation-actions";

  const cancelButton = document.createElement("button");
  cancelButton.type = "button";
  cancelButton.className = "btn btn-ghost";
  cancelButton.textContent = "Cancel";

  const confirmButton = document.createElement("button");
  confirmButton.type = "button";
  confirmButton.className = "btn btn-oscar";
  confirmButton.textContent = "Confirm";

  // CANCEL
  cancelButton.addEventListener("click", async () => {
  const confirmationId =
    confirmation.confirmationId || confirmation.id;

  if (!confirmationId) {
    addOscarMessage("Unable to cancel: confirmation ID is missing.");
    return;
  }

  cancelButton.disabled = true;
  confirmButton.disabled = true;
  cancelButton.textContent = "Cancelling...";

  try {
    const response = await fetch(
      `/api/confirmations/${encodeURIComponent(confirmationId)}/cancel`,
      {
        method: "POST",
        credentials: "same-origin",
        headers: {
          "Content-Type": "application/json",
          "x-csrf-token": csrfToken,
        },
        body: JSON.stringify({}),
      },
    );

    const result = await response.json();

    if (!response.ok || result.success !== true) {
      throw new Error(
        result.error || "Unable to cancel the action.",
      );
    }

    card.remove();
    addOscarMessage("Action cancelled.");
  } catch (error) {
    addOscarMessage(
      error.message || "Unable to cancel the action.",
    );

    cancelButton.disabled = false;
    confirmButton.disabled = false;
    cancelButton.textContent = "Cancel";
  }
});
  // CONFIRM
  confirmButton.addEventListener("click", async () => {
    confirmButton.disabled = true;
    cancelButton.disabled = true;

    confirmButton.innerHTML = `
      <span class="spinner-border spinner-border-sm me-1"></span>
      Confirming...
    `;

    try {
      const response = await fetch("/api/oscar/confirm", {
        method: "POST",

        credentials: "same-origin",

       headers: {
          "Content-Type": "application/json",
          "x-csrf-token": csrfToken,
        },

        body: JSON.stringify({
          confirmationId: confirmation.id,
        }),
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(
          result.error || "Unable to confirm the action."
        );
      }

      confirmationContainer.innerHTML = "";

      const actionResult = result.data;

    if (
        actionResult.action === "send_email" &&
        actionResult.email
      ) {
        addOscarMessage(
          `Email sent successfully to ${actionResult.email.to}.`
        );
      } else if (
        actionResult.action === "create_lead" &&
        actionResult.lead
      ) {
        addOscarMessage(
          `Lead created successfully for ${actionResult.lead.companyName}.`
        );
      } else if (
        actionResult.action === "update_lead" &&
        actionResult.lead
      ) {
        addOscarMessage(
          `Lead updated successfully for ${actionResult.lead.companyName}.`
        );
      } else if (
        actionResult.action === "delete_lead" &&
        actionResult.deletedLead
      ) {
        addOscarMessage(
          `Lead "${actionResult.deletedLead.companyName}" was deleted.`
        );
      } else if (
        actionResult.action === "create_calendar_event" &&
        actionResult.meeting
      ) {
        addOscarMessage(
          `Meeting "${actionResult.meeting.title}" was created successfully.`
        );
      } else if (
        actionResult.action === "update_calendar_event" &&
        actionResult.meeting
      ) {
        addOscarMessage(
          `Meeting "${actionResult.meeting.title}" was updated successfully.`
        );
      } else if (
        actionResult.action === "delete_calendar_event" &&
        actionResult.deletedMeeting
      ) {
        addOscarMessage(
          `Meeting "${actionResult.deletedMeeting.title}" was deleted successfully.`
        );
      } else if (
        actionResult.action === "create_client" &&
        actionResult.client
      ) {
        addOscarMessage(
          `Client "${actionResult.client.companyName}" was created successfully.`
        );
      } else {
        addOscarMessage(
          "The confirmed action was completed successfully."
        );
      }
    } catch (error) {
      console.error("Confirmation error:", error);

      confirmationContainer.innerHTML = "";

      addOscarMessage(
        error.message || "The action could not be completed."
      );
    }
  });

  actions.appendChild(cancelButton);
  actions.appendChild(confirmButton);

  card.appendChild(title);
  card.appendChild(description);

  if (confirmation.details) {
    card.appendChild(details);
  }

  card.appendChild(actions);

  confirmationContainer.appendChild(card);
}
function formatConfirmationLabel(key) {
  const labels = {
    title: "Meeting",
    startAt: "Starts",
    endAt: "Ends",
    meetingType: "Type",
    location: "Location",
    contactName: "Contact",
    contactEmail: "Email",
  };

  return labels[key] || key;
}

function formatConfirmationValue(key, value) {
  if (
    (key === "startAt" || key === "endAt") &&
    value
  ) {
    const date = new Date(value);

    if (!Number.isNaN(date.getTime())) {
      return date.toLocaleString([], {
        dateStyle: "medium",
        timeStyle: "short",
      });
    }
  }

  return String(value);
}

 async function submitOscarMessage(message) {
  const sendButton = document.getElementById("oscarSendMessageBtn");

  if (!voiceConfigured || !message?.trim() || sendButton?.disabled) {
    return;
  }

  if (sendButton) {
    sendButton.disabled = true;
  }

  addOscarMessage(message, "user");

  oscarInput.value = "";

  const thinkingMessage = document.createElement("div");
  thinkingMessage.className = "chat-message oscar-message";
  thinkingMessage.id = "oscarThinking";
  thinkingMessage.textContent = "OSCAR is thinking...";

  oscarMessages.appendChild(thinkingMessage);
  oscarMessages.scrollTop = oscarMessages.scrollHeight;

  try {
    const response = await fetch("/api/oscar/chat", {
      method: "POST",
      credentials: "same-origin",
      headers: {
        "Content-Type": "application/json",
        "x-csrf-token": csrfToken,
      },
      body: JSON.stringify({ message }),
    });

    const result = await response.json();

    document.getElementById("oscarThinking")?.remove();

    if (response.status === 503) {
      addOscarMessage(
        "OSCAR AI is currently offline. Add OPENAI_API_KEY to activate AI capabilities."
      );
      return;
    }

    if (!response.ok || !result.success) {
      throw new Error(
        result.error || "OSCAR could not process your request."
      );
    }

    addOscarMessage(result.data.response);

    if (result.data.confirmation) {
      showConfirmation(result.data.confirmation);
    }
  } catch (error) {
    console.error("OSCAR chat error:", error);

    document.getElementById("oscarThinking")?.remove();

    addOscarMessage(
      error.message || "Unable to connect to OSCAR."
    );
  } finally {
    if (sendButton) {
      sendButton.disabled = !voiceConfigured;
    }
  }
}

oscarChatForm?.addEventListener("submit", async (event) => {
  event.preventDefault();

  await submitOscarMessage(oscarInput.value.trim());
});

document.querySelectorAll("[data-oscar-prompt]").forEach((button) => {
  button.addEventListener("click", async () => {
    const prompt = button.dataset.oscarPrompt?.trim();

    if (!prompt) {
      return;
    }

    oscarInput.value = prompt;

    await submitOscarMessage(prompt);
  });
});

// ================= OSCAR REALTIME VOICE =================

const oscarVoiceBtn = document.getElementById("oscarVoiceBtn");
const oscarVoiceStatus = document.getElementById("oscarVoiceStatus");
const oscarVoiceAudio = document.getElementById("oscarVoiceAudio");

let oscarVoicePC = null;
let oscarVoiceStream = null;
let oscarVoiceChannel = null;
let oscarVoiceActive = false;
let oscarVoiceStarting = false;
let oscarVoiceStopping = false;
let oscarVoiceSessionId = 0;

const sidebarVoicePanel = document.getElementById("oscarSidebarVoice");
const sidebarVoiceStart = document.getElementById("sidebarVoiceStart");
const sidebarVoiceMute = document.getElementById("sidebarVoiceMute");
const sidebarVoiceEnd = document.getElementById("sidebarVoiceEnd");
const sidebarVoiceStatus = document.getElementById("sidebarVoiceStatus");
const sidebarVoiceBadge = document.getElementById("sidebarVoiceBadge");

const voiceConfigured =
  sidebarVoicePanel?.dataset.configured === "true";

  document.querySelectorAll("[data-oscar-prompt]").forEach((button) => {
  button.disabled = !voiceConfigured;

  if (!voiceConfigured) {
    button.title = "Available after AI setup is complete.";
  }
});

function syncOscarVoiceControls() {
  const tracks = oscarVoiceStream?.getAudioTracks() || [];
  const microphoneMuted =
    tracks.length > 0 && tracks.every((track) => !track.enabled);

  const busy = oscarVoiceStarting || oscarVoiceStopping;
  const canMute = oscarVoiceActive && tracks.length > 0;

  sidebarVoiceStart.disabled =
    !voiceConfigured || busy || oscarVoiceActive;

  sidebarVoiceEnd.disabled =
    oscarVoiceStopping || (!oscarVoiceActive && !oscarVoiceStarting);

  sidebarVoiceMute.disabled = !canMute;
  sidebarVoiceMute.textContent = microphoneMuted ? "Unmute" : "Mute";
  sidebarVoiceMute.setAttribute(
    "aria-pressed",
    String(microphoneMuted),
  );

  if (!voiceConfigured) {
    sidebarVoiceBadge.textContent = "Not configured";
  } else if (oscarVoiceStopping) {
    sidebarVoiceBadge.textContent = "Ending";
  } else if (oscarVoiceStarting) {
    sidebarVoiceBadge.textContent = "Connecting";
  } else if (oscarVoiceActive) {
    sidebarVoiceBadge.textContent = microphoneMuted ? "Muted" : "Active";
  } else {
    sidebarVoiceBadge.textContent = "Ready";
  }

  sidebarVoiceBadge.className =
    oscarVoiceActive && !microphoneMuted
      ? "badge bg-success"
      : "badge bg-secondary";

  if (oscarVoiceBtn) {
    oscarVoiceBtn.disabled = !voiceConfigured || busy;
  }
}

sidebarVoiceStart.addEventListener("click", () => {
  void startOscarVoice();
});

sidebarVoiceEnd.addEventListener("click", () => {
  void stopOscarVoice();
});

sidebarVoiceMute.addEventListener("click", () => {
  if (!oscarVoiceActive || !oscarVoiceStream) return;

  const tracks = oscarVoiceStream.getAudioTracks();
  const currentlyMuted = tracks.every((track) => !track.enabled);

  tracks.forEach((track) => {
    track.enabled = currentlyMuted;
  });

  syncOscarVoiceControls();
});

function setOscarVoiceStatus(message) {
  if (oscarVoiceStatus) {
    oscarVoiceStatus.textContent = message;
  }

  if (sidebarVoiceStatus) {
    sidebarVoiceStatus.textContent = message;
  }

  syncOscarVoiceControls();
}

function sendOscarVoiceEvent(event) {
  if (oscarVoiceChannel?.readyState === "open") {
    oscarVoiceChannel.send(JSON.stringify(event));
  }
}

async function handleOscarVoiceToolCall(event) {

    const sessionId = oscarVoiceSessionId;
    const channel = oscarVoiceChannel;

    if (!channel || channel.readyState !== "open") {
      return;
    }
  if (event.name !== "ask_oscar") {
    sendOscarVoiceEvent({
      type: "conversation.item.create",
      item: {
        type: "function_call_output",
        call_id: event.call_id,
        output: JSON.stringify({
          success: false,
          error: "Unsupported OSCAR tool.",
        }),
      },
    });

    sendOscarVoiceEvent({ type: "response.create" });
    return;
  }

  let output;

  try {
    const args = JSON.parse(event.arguments || "{}");

    if (
      typeof args.message !== "string" ||
      !args.message.trim() ||
      args.message.length > 4000
    ) {
      throw new Error("Invalid voice request.");
    }

    setOscarVoiceStatus("OSCAR is working on your request...");

    const response = await fetch("/api/oscar/chat", {
      method: "POST",
      credentials: "same-origin",
     headers: {
        "Content-Type": "application/json",
        "x-csrf-token": csrfToken,
      },
      body: JSON.stringify({
        message: args.message.trim(),
      }),
    });

    const result = await response.json();

    if (!response.ok || !result.success) {
      throw new Error(
        result.error || "OSCAR could not complete your request."
      );
    }

    const data = result.data;

    // Keep consequential actions behind OSCAR's existing confirmation UI.
    if (data.confirmation) {
      showConfirmation(data.confirmation);
    }

    output = {
      success: true,
      response: data.response,
      confirmationRequired: Boolean(data.confirmation),
      confirmationDescription: data.confirmation?.description ?? null,
    };
  } catch (error) {
    console.error("OSCAR voice tool error:", error);

    output = {
      success: false,
      error: error.message || "Unable to process your request.",
    };
  }

    // Ignore results from a session that has ended or been replaced.
    if (
      sessionId !== oscarVoiceSessionId ||
      channel !== oscarVoiceChannel ||
      channel.readyState !== "open"
    ) {
      return;
    }

        channel.send(
        JSON.stringify({
          type: "conversation.item.create",
          item: {
            type: "function_call_output",
            call_id: event.call_id,
            output: JSON.stringify(output),
          },
        })
      );

      // Request one response after returning the tool result.
      channel.send(JSON.stringify({ type: "response.create" }));
    }

function handleOscarVoiceEvent(event) {
  switch (event.type) {
    case "session.created":
      setOscarVoiceStatus("OSCAR is listening. Speak naturally.");
      break;

    case "input_audio_buffer.speech_started":
      setOscarVoiceStatus("Listening to you...");
      break;

    case "input_audio_buffer.speech_stopped":
      setOscarVoiceStatus("OSCAR is thinking...");
      break;

    case "conversation.item.input_audio_transcription.completed":
      if (event.transcript?.trim()) {
        addOscarMessage(event.transcript.trim(), "user");
      }
      break;

    case "response.output_audio_transcript.done":
      if (event.transcript?.trim()) {
        addOscarMessage(event.transcript.trim());
      }

      setOscarVoiceStatus("OSCAR is listening. Keep talking.");
      break;

    case "response.function_call_arguments.done":
      void handleOscarVoiceToolCall(event);
      break;

    case "error":
      console.error("OSCAR Realtime error:", event.error);
      setOscarVoiceStatus(
        event.error?.message || "Voice encountered an error."
      );
      break;
  }
}

async function startOscarVoice() {

    if (!voiceConfigured) {
    setOscarVoiceStatus(
      "Voice will be available after AI setup is complete.",
    );
    return;
  }

  if (oscarVoiceActive || oscarVoiceStarting || oscarVoiceStopping) return;

  const sessionId = ++oscarVoiceSessionId;

  if (
    !navigator.mediaDevices?.getUserMedia ||
    !window.RTCPeerConnection
  ) {
    setOscarVoiceStatus("Voice is unavailable in this browser or connection.");
    return;
  }

  oscarVoiceStarting = true;
  oscarVoiceBtn.disabled = true;
  setOscarVoiceStatus("Connecting to OSCAR Voice...");

  try {
    // Request microphone access.
    const microphoneStream =
      await navigator.mediaDevices.getUserMedia({ audio: true });

    if (sessionId !== oscarVoiceSessionId || oscarVoiceStopping) {
      microphoneStream.getTracks().forEach((track) => track.stop());
      return;
    }

    oscarVoiceStream = microphoneStream;

    // Request a short-lived credential from OSCAR's authenticated backend.
    const sessionResponse = await fetch("/api/oscar/voice/session", {
      method: "POST",
      credentials: "same-origin",
      headers: {
        "Content-Type": "application/json",
        "x-csrf-token": csrfToken,
      },
    });

    const sessionResult = await sessionResponse.json();

    if (sessionId !== oscarVoiceSessionId || oscarVoiceStopping) return;

    if (!sessionResponse.ok || !sessionResult.success) {
      throw new Error(
        sessionResult.error || "Could not create a voice session."
      );
    }

    const clientSecret = sessionResult.data?.clientSecret;

    if (!clientSecret) {
      throw new Error("The voice session returned no client credential.");
    }

    // Establish the WebRTC connection.
    const peerConnection = new RTCPeerConnection();
    oscarVoicePC = peerConnection;

    peerConnection.ontrack = (event) => {
      if (
        sessionId !== oscarVoiceSessionId ||
        peerConnection !== oscarVoicePC
      ) {
        return;
      }

      if (event.streams?.[0]) {
        oscarVoiceAudio.srcObject = event.streams[0];

        oscarVoiceAudio.play().catch((error) => {
          console.warn("Audio playback needs user interaction:", error);
        });
      }
    };

    peerConnection.onconnectionstatechange = () => {
      if (
        sessionId !== oscarVoiceSessionId ||
        peerConnection !== oscarVoicePC
      ) {
        return;
      }

      const state = peerConnection.connectionState;

      if (state === "connected") {
        setOscarVoiceStatus("OSCAR is listening. Speak naturally.");
      } else if (state === "disconnected") {
        setOscarVoiceStatus(
          "Voice connection interrupted. You may need to reconnect."
        );
      } else if (state === "failed") {
        setOscarVoiceStatus(
          "Voice connection failed. Please restart the conversation."
        );
        void stopOscarVoice();
      }
    };

    microphoneStream.getTracks().forEach((track) => {
      peerConnection.addTrack(track, microphoneStream);
    });

    // Receive Realtime API events.
    const dataChannel = peerConnection.createDataChannel("oscar-events");
    oscarVoiceChannel = dataChannel;

    dataChannel.addEventListener("open", () => {
      if (
        sessionId === oscarVoiceSessionId &&
        dataChannel === oscarVoiceChannel
      ) {
        setOscarVoiceStatus("OSCAR is listening. Speak naturally.");
      }
    });

    dataChannel.addEventListener("message", (message) => {
      if (
        sessionId !== oscarVoiceSessionId ||
        dataChannel !== oscarVoiceChannel
      ) {
        return;
      }

      try {
        handleOscarVoiceEvent(JSON.parse(message.data));
      } catch (error) {
        console.error("Invalid OSCAR voice event:", error);
      }
    });

    // Create the WebRTC offer.
    const offer = await peerConnection.createOffer();

    if (sessionId !== oscarVoiceSessionId || oscarVoiceStopping) return;

    await peerConnection.setLocalDescription(offer);

    if (sessionId !== oscarVoiceSessionId || oscarVoiceStopping) return;

    const answerResponse = await fetch(
      "https://api.openai.com/v1/realtime/calls",
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${clientSecret}`,
          "Content-Type": "application/sdp",
        },
        body: offer.sdp,
      }
    );

    if (!answerResponse.ok) {
      const errorText = await answerResponse.text();

      console.error(
        "Realtime connection failed:",
        answerResponse.status,
        errorText
      );

      throw new Error("Unable to establish the realtime connection.");
    }

    const answerSdp = await answerResponse.text();

    if (
      sessionId !== oscarVoiceSessionId ||
      oscarVoiceStopping ||
      peerConnection !== oscarVoicePC
    ) {
      return;
    }

    await peerConnection.setRemoteDescription({
      type: "answer",
      sdp: answerSdp,
    });

    if (
      sessionId !== oscarVoiceSessionId ||
      oscarVoiceStopping ||
      peerConnection !== oscarVoicePC
    ) {
      return;
    }

    oscarVoiceActive = true;

    oscarVoiceBtn.setAttribute("aria-pressed", "true");
    oscarVoiceBtn.title = "End voice conversation";
    oscarVoiceBtn.innerHTML = '<i class="bi bi-telephone-x-fill"></i>';

    setOscarVoiceStatus("Connected. You can speak to OSCAR.");
    } catch (error) {
    console.error("OSCAR voice startup failed:", error);

    if (sessionId === oscarVoiceSessionId) {
      await stopOscarVoice();

      setOscarVoiceStatus(
        error.message || "Could not start OSCAR Voice.",
      );
    }
  } finally {
    if (sessionId === oscarVoiceSessionId) {
      oscarVoiceStarting = false;
      syncOscarVoiceControls();
    }
  }
}

async function stopOscarVoice() {
  if (oscarVoiceStopping) return;

  oscarVoiceStopping = true;
  oscarVoiceSessionId++;

  try {
    oscarVoiceActive = false;

    if (oscarVoiceChannel) {
      oscarVoiceChannel.close();
      oscarVoiceChannel = null;
    }

    if (oscarVoicePC) {
      oscarVoicePC.close();
      oscarVoicePC = null;
    }

    if (oscarVoiceStream) {
      oscarVoiceStream.getTracks().forEach((track) => {
        track.stop();
      });

      oscarVoiceStream = null;
    }

    if (oscarVoiceAudio) {
      oscarVoiceAudio.pause();
      oscarVoiceAudio.srcObject = null;
    }

    if (oscarVoiceBtn) {
    oscarVoiceBtn.disabled = false;
    oscarVoiceBtn.setAttribute("aria-pressed", "false");
    oscarVoiceBtn.title = "Start voice conversation";
    oscarVoiceBtn.innerHTML = '<i class="bi bi-mic-fill"></i>';
    }

    setOscarVoiceStatus("Voice conversation ended.");
   } finally {
    oscarVoiceStarting = false;
    oscarVoiceStopping = false;
    syncOscarVoiceControls();
  }
}

oscarVoiceBtn?.addEventListener("click", () => {
  if (oscarVoiceActive) {
    void stopOscarVoice();
  } else {
    void startOscarVoice();
  }
});

// Release the microphone if the user leaves the dashboard.
window.addEventListener("pagehide", () => {
  void stopOscarVoice();
});

// ================= END OSCAR REALTIME VOICE =================
</script>
<script>
  (() => {
    const list = document.getElementById("dashboardActivityList");
    if (!list) return;

    let frame;

    function fitFourActivities() {
      const rows = Array.from(list.children);

      if (rows.length <= 4) {
        list.style.removeProperty("max-height");
        return;
      }

      const first = rows[0].getBoundingClientRect();
      const fourth = rows[3].getBoundingClientRect();
      const styles = getComputedStyle(list);

      const padding =
        (parseFloat(styles.paddingTop) || 0) +
        (parseFloat(styles.paddingBottom) || 0);

      const borders =
        (parseFloat(styles.borderTopWidth) || 0) +
        (parseFloat(styles.borderBottomWidth) || 0);

      const extra =
        styles.boxSizing === "border-box" ? padding + borders : 0;

      list.style.maxHeight =
        `${Math.ceil(fourth.bottom - first.top + extra)}px`;
    }

    function scheduleFit() {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(fitFourActivities);
    }

    const observer = new ResizeObserver(scheduleFit);

    Array.from(list.children)
      .slice(0, 4)
      .forEach((row) => observer.observe(row));

    scheduleFit();
    document.fonts?.ready.then(scheduleFit);
  })();
</script>