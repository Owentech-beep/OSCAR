<div class="container-fluid py-4">
  <!-- Back -->
  <div class="mb-4">
    <a href="/leads" class="btn btn-outline-light">
      <i class="bi bi-arrow-left me-2"></i>
      Back to Leads
    </a>
  </div>

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <p class="text-uppercase text-primary fw-bold mb-1">Lead Profile</p>

      <h1 class="fw-bold text-white mb-0" id="companyName">Loading...</h1>
    </div>

    <div class="d-flex gap-2 align-items-center">
      <div id="statusBadge"></div>

      <a href="/leads/<%= leadId %>/edit" class="btn btn-outline-light">
        <i class="bi bi-pencil me-2"></i>
        Edit
      </a>

      <button type="button" class="btn btn-outline-danger" id="deleteLeadBtn">
        <i class="bi bi-trash me-2"></i>
        Delete
      </button>
    </div>
  </div>

  <!-- Lead Information -->
  <div class="row g-4">
    <!-- Company -->
    <div class="col-lg-6">
      <div class="card bg-dark border-secondary shadow-sm h-100">
        <div class="card-body p-4">
          <h5 class="text-white mb-4">
            <i class="bi bi-building me-2 text-primary"></i>
            Company Information
          </h5>

          <div class="mb-3">
            <small class="text-secondary">Company</small>
            <div class="text-white" id="company"></div>
          </div>

          <div class="mb-3">
            <small class="text-secondary">Industry</small>
            <div class="text-white" id="industry"></div>
          </div>

          <div class="mb-3">
            <small class="text-secondary">Location</small>
            <div class="text-white" id="location"></div>
          </div>

          <div>
            <small class="text-secondary">Website</small>
            <div id="website"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact -->
    <div class="col-lg-6">
      <div class="card bg-dark border-secondary shadow-sm h-100">
        <div class="card-body p-4">
          <h5 class="text-white mb-4">
            <i class="bi bi-person me-2 text-primary"></i>
            Contact Information
          </h5>

          <div class="mb-3">
            <small class="text-secondary">Contact Name</small>
            <div class="text-white" id="contactName"></div>
          </div>

          <div class="mb-3">
            <small class="text-secondary">Email</small>
            <div class="text-white" id="email"></div>
          </div>

          <div class="mb-3">
            <small class="text-secondary">Phone</small>
            <div class="text-white" id="phone"></div>
          </div>

          <div>
            <small class="text-secondary">Lead Source</small>
            <div class="text-white" id="source"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Lead Score -->
    <div class="col-lg-4">
      <div class="card bg-dark border-secondary shadow-sm h-100">
        <div class="card-body p-4 text-center">
          <h5 class="text-white mb-4">Lead Score</h5>

          <div class="display-3 fw-bold text-primary" id="leadScore">0</div>

          <small class="text-secondary"> Current qualification score </small>
        </div>
      </div>
    </div>

    <!-- Dates -->
    <div class="col-lg-8">
      <div class="card bg-dark border-secondary shadow-sm h-100">
        <div class="card-body p-4">
          <h5 class="text-white mb-4">
            <i class="bi bi-calendar3 me-2 text-primary"></i>
            Lead Activity
          </h5>

          <div class="row">
            <div class="col-md-4 mb-3">
              <small class="text-secondary">Created</small>
              <div class="text-white" id="createdAt"></div>
            </div>

            <div class="col-md-4 mb-3">
              <small class="text-secondary">Last Contact</small>
              <div class="text-white" id="lastContact"></div>
            </div>

            <div class="col-md-4 mb-3">
              <small class="text-secondary">Next Follow-up</small>
              <div class="text-white" id="nextFollowUp"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Notes -->
    <div class="col-12">
      <div class="card bg-dark border-secondary shadow-sm">
        <div class="card-body p-4">
          <h5 class="text-white mb-3">
            <i class="bi bi-journal-text me-2 text-primary"></i>
            Notes
          </h5>

          <p class="text-secondary mb-0" id="notes">No notes available.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- OSCAR AI Analysis -->
  <div class="col-12">
    <div class="card bg-dark border-primary shadow-sm">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
            <p class="text-uppercase text-primary fw-bold mb-1">
              OSCAR Intelligence
            </p>

            <h5 class="text-white mb-0">
              <i class="bi bi-robot me-2 text-primary"></i>
              AI Lead Analysis
            </h5>
          </div>

          <button type="button" class="btn btn-primary" id="analyzeLeadBtn">
            <i class="bi bi-stars me-2"></i>
            Analyze Lead
          </button>
        </div>

        <div id="analysisContent">
          <p class="text-secondary mb-0">
            OSCAR has not analyzed this lead yet.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const leadId = "<%= leadId %>";

  async function loadAnalysis() {
    const content = document.getElementById("analysisContent");

    try {
      const response = await fetch(`/api/leads/${leadId}/analysis`);
      const result = await response.json();

      // No analysis exists yet
      if (response.status === 404) {
        content.innerHTML = `
        <p class="text-secondary mb-0">
          OSCAR has not analyzed this lead yet.
        </p>
      `;
        return;
      }

      if (!response.ok || !result.success) {
        throw new Error(
          result.error || result.message || "Failed to load analysis",
        );
      }

      const analysis = result.data;

      renderAnalysis(analysis);
    } catch (error) {
      console.error("Error loading OSCAR analysis:", error);

      content.innerHTML = `
      <div class="alert alert-warning mb-0">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Unable to load OSCAR analysis.
      </div>
    `;
    }
  }

  function renderAnalysis(analysis) {
    const content = document.getElementById("analysisContent");

    content.innerHTML = `
    <div class="row g-4">

      <div class="col-md-3">
        <small class="text-secondary">AI Score</small>
        <div class="display-5 fw-bold text-primary">
          ${analysis.score}
        </div>
      </div>

      <div class="col-md-3">
        <small class="text-secondary">Qualification</small>
        <div class="text-white fw-bold mt-2">
          ${analysis.qualification}
        </div>
      </div>

      <div class="col-md-6">
        <small class="text-secondary">Recommended Action</small>
        <div class="text-white mt-2">
          ${analysis.recommendedAction}
        </div>
      </div>

      <div class="col-12">
        <small class="text-secondary">Reasoning</small>
        <p class="text-white mt-2 mb-0">
          ${analysis.reasoning}
        </p>
      </div>

      <div class="col-md-6">
        <small class="text-secondary">Strengths</small>
        <ul class="text-white mt-2">
          ${analysis.strengths.map((item) => `<li>${item}</li>`).join("")}
        </ul>
      </div>

      <div class="col-md-6">
        <small class="text-secondary">Concerns</small>
        <ul class="text-white mt-2">
          ${analysis.concerns.map((item) => `<li>${item}</li>`).join("")}
        </ul>
      </div>

    </div>
  `;
  }

  async function loadLead() {
    try {
      const response = await fetch(`/api/leads/${leadId}`);
      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.message || "Failed to load lead");
      }

      const lead = result.data;

      // Header
      document.getElementById("companyName").textContent =
        lead.companyName || "Unnamed Company";

      // Company
      document.getElementById("company").textContent =
        lead.companyName || "Not provided";

      document.getElementById("industry").textContent =
        lead.industry || "Not provided";

      document.getElementById("location").textContent =
        lead.location || "Not provided";

      // Website
      const websiteElement = document.getElementById("website");

      if (lead.website) {
        websiteElement.innerHTML = `
          <a
            href="${lead.website}"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary"
          >
            ${lead.website}
          </a>
        `;
      } else {
        websiteElement.textContent = "Not provided";
      }

      // Contact
      document.getElementById("contactName").textContent =
        lead.contactName || "Not provided";

      document.getElementById("email").textContent =
        lead.email || "Not provided";

      document.getElementById("phone").textContent =
        lead.phone || "Not provided";

      document.getElementById("source").textContent =
        lead.source || "Not provided";

      // Score
      document.getElementById("leadScore").textContent = lead.leadScore ?? 0;

      // Status
      document.getElementById("statusBadge").innerHTML = `
        <span class="badge bg-primary fs-6 px-3 py-2">
          ${lead.status || "New"}
        </span>
      `;

      // Dates
      document.getElementById("createdAt").textContent = formatDate(
        lead.createdAt,
      );

      document.getElementById("lastContact").textContent = formatDate(
        lead.lastContact,
      );

      document.getElementById("nextFollowUp").textContent = formatDate(
        lead.nextFollowUp,
      );

      // Notes
      document.getElementById("notes").textContent =
        lead.notes || "No notes available.";
    } catch (error) {
      console.error("Error loading lead:", error);

      document.getElementById("companyName").textContent =
        "Unable to load lead";
    }
  }

  function formatDate(date) {
    if (!date) {
      return "Not provided";
    }

    return new Date(date).toLocaleDateString();
  }

  loadLead();
  loadAnalysis();

  document
    .getElementById("deleteLeadBtn")
    .addEventListener("click", async () => {
      const confirmed = confirm(
        "Are you sure you want to delete this lead? This action cannot be undone.",
      );

      if (!confirmed) {
        return;
      }

      const deleteButton = document.getElementById("deleteLeadBtn");

      deleteButton.disabled = true;

      deleteButton.innerHTML = `
      <span class="spinner-border spinner-border-sm me-2"></span>
      Deleting...
    `;

      try {
        const response = await fetch(`/api/leads/${leadId}`, {
          method: "DELETE",
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || "Failed to delete lead");
        }

        window.location.href = "/leads";
      } catch (error) {
        console.error("Error deleting lead:", error);

        alert(error.message || "Something went wrong while deleting the lead.");

        deleteButton.disabled = false;

        deleteButton.innerHTML = `
        <i class="bi bi-trash me-2"></i>
        Delete
      `;
      }
    });

  document
    .getElementById("analyzeLeadBtn")
    .addEventListener("click", async () => {
      const button = document.getElementById("analyzeLeadBtn");
      const content = document.getElementById("analysisContent");

      button.disabled = true;

      button.innerHTML = `
      <span class="spinner-border spinner-border-sm me-2"></span>
      OSCAR is analyzing...
    `;

      content.innerHTML = `
      <div class="text-secondary">
        <i class="bi bi-hourglass-split me-2"></i>
        OSCAR is analyzing this lead...
      </div>
    `;

      try {
        const response = await fetch(`/api/leads/${leadId}/analyze`, {
          method: "POST",
          credentials: "same-origin",
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(
            result.error || result.message || "AI analysis failed",
          );
        }

        const analysis = result.data;

        content.innerHTML = `
        <div class="row g-4">

          <div class="col-md-3">
            <small class="text-secondary">AI Score</small>
            <div class="display-5 fw-bold text-primary">
              ${analysis.score}
            </div>
          </div>

          <div class="col-md-3">
            <small class="text-secondary">Qualification</small>
            <div class="text-white fw-bold mt-2">
              ${analysis.qualification}
            </div>
          </div>

          <div class="col-md-6">
            <small class="text-secondary">Recommended Action</small>
            <div class="text-white mt-2">
              ${analysis.recommendedAction}
            </div>
          </div>

          <div class="col-12">
            <small class="text-secondary">Reasoning</small>
            <p class="text-white mt-2 mb-0">
              ${analysis.reasoning}
            </p>
          </div>

          <div class="col-md-6">
            <small class="text-secondary">Strengths</small>
            <ul class="text-white mt-2">
              ${analysis.strengths.map((item) => `<li>${item}</li>`).join("")}
            </ul>
          </div>

          <div class="col-md-6">
            <small class="text-secondary">Concerns</small>
            <ul class="text-white mt-2">
              ${analysis.concerns.map((item) => `<li>${item}</li>`).join("")}
            </ul>
          </div>

        </div>
      `;
      } catch (error) {
        console.error("OSCAR analysis error:", error);

        content.innerHTML = `
        <div class="alert alert-warning mb-0">
          <i class="bi bi-exclamation-triangle me-2"></i>
          ${error.message}
        </div>
      `;
      } finally {
        button.disabled = false;

        button.innerHTML = `
        <i class="bi bi-stars me-2"></i>
        Analyze Lead
      `;
      }
    });
</script>
